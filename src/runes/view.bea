def file_icon(name: String, folder: Bool, open: Bool, language: String) -> (String, String, String, String)

@external(javascript, "../runes_ffi.mjs", "when")
def when(seconds: Int) -> String

@external(javascript, "../runes_ffi.mjs", "month_grid")
