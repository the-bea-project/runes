/// Tabs that show a view of Runes' own instead of a file.
pub const settings_tab = "runes://settings"

pub const graph_tab = "runes://graph"

pub const diff_tab = "runes://diff/"

pub const terminal_tab = "runes://terminal/"

pub const extension_tab = "runes://extension/"

pub const preview_tab = "runes://preview/"

/// A saved SSH session: a machine, who to be on it, and where to start. Nothing secret.
pub type Session {
  id: String,
  name: String,
  host: String,
  user: String,
  port: Int,
  /// A private key file on this machine, or "" to try the usual ones.
  key: String,
  /// The folder to open over there, or "" for the home folder.
  folder: String,
  /// Its key has been seen and accepted before.
  known: Bool,
  /// How to sign in: "auto" (whatever works), or only by "password", "key" or "agent".
  auth: String,
}

/// A name being typed in the explorer: of a new "file" or "folder" inside `at`, or the new
/// name when `at` itself is being given one ("rename").
pub type Naming {
  kind: String,
  at: String,
  text: String,
}

/// A question from the shell, shown over the window until it is answered: a "secret"
/// (typed hidden), a "text", or a "confirm".
pub type Prompt {
  id: Int,
  kind: String,
  title: String,
  detail: String,
  text: String,
}

/// A file as it was at some commit: the tab is "runes://at/" and the file's path in the
/// repository. Which commit is kept beside it (`travel`), so stepping through the file's
/// history changes what the one tab shows.
pub const at_tab = "runes://at/"

/// A tab that shows a file on disk, as opposed to a view of Runes' own, an untitled
/// buffer, or a file as it was in the past.
/// Drawings: the language their files have, and how their names end.
pub const canvas_language = "rune"

pub const canvas_extension = ".rux"

/// Whether a file is on show as a board to draw on, not as text to type in.
pub def is_canvas(model: Model, d: Doc) -> Bool {
  d.language == canvas_language and not list.contains(model.raw, d.path)
}

pub def on_disk(d: Doc) -> Bool {
  d.language != "runes" and not d.untitled and not string.starts_with(d.path, "runes://")
}

/// What an extension's page shows. For an installed extension the manifest fills most of it;
/// for one in the marketplace, the search result does.
pub type Page {
  key: String,
  namespace: String,
  name: String,
  title: String,
  description: String,
  version: String,
  installs: Int,
  /// The address of its picture in the marketplace, or "".
  picture: String,
  readme: String,
  /// The readme is still on its way.
  loading: Bool,
}

/// What the diff tab is comparing.
pub type Compare {
  /// Sessions are numbered; each has its own tab.
  id: Int,
  /// Two files on disk rather than two points in the history.
  files_mode: Bool,
  /// What was asked for: a branch, tag or commit on each side ("" on the right means the
  /// files as they are now), or two file paths.
  from: String,
  to: String,
  /// `from` as git resolved it.
  base: String,
  /// The files that differ: git's letter for how, then the path.
  files: List((String, String)),
  /// The file being shown, and its two versions.
  file: String,
  left: List(String),
  right: List(String),
  /// Show every line, rather than folding the unchanged stretches away.
  whole: Bool,
  note: String,
  /// List every file there was at the commit, not only the ones that changed, and the
  /// text typed to narrow that list.
  everything: Bool,
  filter: String,
  /// Old and new side by side. Otherwise the changes read as one text, top to bottom.
  split: Bool,
}

// --- The model -------------------------------------------------------------------------

/// A set of tabs: one tile of the editor area.
pub type Group {
  id: Int,
  tabs: List(String),
  active: String,
}

/// Something a language server (or another extension) says about a place in a file.
pub type Diagnostic {
  from: Pos,
  to: Pos,
  /// 1 error, 2 warning, 3 information, 4 hint.
  severity: Int,
  message: String,
  source: String,
}

/// A match of the search across files.
pub type Hit {
  path: String,
  line: Int,
  col: Int,
  length: Int,
  text: String,
}

/// What is being looked for: in the file (the find widget) or in the folder.
pub type Query {
  text: String,
  replace: String,
  regex: Bool,
  match_case: Bool,
  word: Bool,
}

/// Who last changed a line of a file, as git tells it. `known` is false when git has no
/// answer (no repository, a file it has never seen); `hash` is "" for a line not committed yet.
/// `version` is the edit of the file the answer was true for.
pub type Blame {
  path: String,
  line: Int,
  version: Int,
  known: Bool,
  hash: String,
  author: String,
  time: Int,
  summary: String,
}

/// An extension that brings code, as the extension host has it: "waiting" to be needed,
/// "starting", "active", "failed" or "stopped"; how long it took to start; and what it has
/// said, each line with its time and the channel it was said on.
pub type Running {
  id: String,
  name: String,
  version: String,
  state: String,
  ms: Int,
  error: String,
  dropped: Int,
  lines: List((String, String, String)),
}

pub const running_tab = "runes://running"

pub type Overlay {
  Closed
  /// A list to pick from: "commands", "files", "themes" or "line".
  Palette(kind: String, query: String, index: Int)
  /// The pie menu, centred on a point. `hold` means releasing the button picks.
  /// `path` says which submenu is open ([] for the top level), and `back` remembers where
  /// each pie above it was centred.
  Pie(x: Int, y: Int, hover: Int, hold: Bool, path: List(Int), back: List((Int, Int)))
  /// The menu a right click opens.
  Menu(x: Int, y: Int)
  /// The menu of a file or folder in the explorer.
  NodeMenu(x: Int, y: Int, path: String, folder: Bool)
}

pub type Hover {
  group: Int,
  at: Pos,
  text: String,
  /// From a language server, to be drawn as Markdown; otherwise plain words (a problem's message).
  rich: Bool,
}

pub type Model {
  ready: Bool,
  native: Bool,
  version: String,
  platform: String,
  root: String,
  tree: Dict(String, List((String, Bool))),
  expanded: List(String),
  files: List(String),
  docs: List(Doc),
  groups: List(Group),
  layout: Layout,
  /// The group that has the keyboard.
  focus: Int,
  group_ids: Int,
  maximized: Bool,
  extensions: List(Extension),
  langs: List(Lang),
  settings: Settings,
  /// settings.json as it is on disk; the settings view rewrites it one key at a time.
  settings_text: String,
  settings_path: String,
  keys_path: String,
  bindings: List(Binding),
  /// Added to the font size by Ctrl and the wheel.
  font_zoom: Int,
  side: String,
  side_width: Int,
  /// "" when closed, else "problems", "terminal" or "output".
  panel: String,
  panel_height: Int,
  terminals: List(Int),
  terminal: Int,
  terminal_ids: Int,
  overlay: Overlay,
  finding: Bool,
  replacing: Bool,
  find: Query,
  matches: List((Int, Int, Int)),
  search: Query,
  hits: List(Hit),
  search_note: String,
  completion: Option(Completion),
  hover: Option(Hover),
  diagnostics: Dict(String, List(Diagnostic)),
  output: List(String),
  heights: Dict(Int, Int),
  tops: Dict(String, Int),
  /// Where to put the cursor once a file has been read.
  goto: Option((String, Pos)),
  /// The tab being dragged, and the group it left (-1 from the explorer).
  drag: Option((String, Int)),
  drop: Option((Int, Edge)),
  /// Version control: whether the folder is a repository, and what has changed in it.
  repo: Bool,
  branch: String,
  ahead: Int,
  behind: Int,
  /// Changed files: path, then the staged and the unstaged state as git's letters.
  changes: List((String, String, String)),
  rows: List(Row),
  /// The commit that is selected in the graph, and what it changed.
  picked: String,
  detail: String,
  /// The year and month the graph's calendar shows.
  calendar: (Int, Int),
  /// How far out the calendar is looking: "days" of a month, "months" of a year, or "years".
  calendar_zoom: String,
  /// Commits per day, per month ("2026-11") and per year over the whole history, so the
  /// calendar can show decades the graph has not loaded.
  days: Dict(String, Int),
  months: Dict(String, Int),
  years: Dict(String, Int),
  /// The graph shows the history up to the end of this day ("" for up to now), and this is
  /// the day to select once it has loaded.
  until: String,
  jump: String,
  /// The marketplace search: what was asked, what came back, and a note.
  market_query: String,
  market: List((String, String, String, String, String, Int, String)),
  /// Marketplace icons that have arrived, by their address.
  icons: Dict(String, String),
  /// Each open file as it is in the last commit, with a number that changes when it does.
  bases: Dict(String, (Int, List(String))),
  base_ids: Int,
  /// Every comparison is a session of its own: a commit being read, two branches side by
  /// side, two files. They stay in the list until they are closed there.
  sessions: List(Compare),
  /// Drawings (.rux files) that are being shown as their text rather than as a board.
  raw: List(String),
  /// Blocks folded away, by file: the line each starts on (which stays on show) and its last line.
  /// Extensions that are installed but switched off: nothing of theirs is used or run.
  off: List(Extension),
  /// The extensions with code, as the extension host reports them, and the one whose output is on show.
  running: List(Running),
  running_pick: String,
  /// The explorer: the files and folders chosen (besides the one pointed at), and those
  /// copied or cut there, waiting to be pasted.
  chosen: List(String),
  clip: Option((List(String), Bool)),
  folds: Dict(String, List((Int, Int))),
  /// One step of indentation for each open file ("\t" or some spaces), as it was read from
  /// the file or picked in the status bar. A file not here follows the settings.
  indents: Dict(String, String),
  session_ids: Int,
  /// A commit set aside in the graph, to compare another one with.
  marked: String,
  /// Branches and tags: the kind ("branch", "remote" or "tag"), then the name.
  refs: List((String, String)),
  /// What the selected commit changed.
  picked_files: List((String, String)),
  /// Terminals shown as tabs among the editors rather than in the panel.
  terminal_tabs: List(Int),
  /// The SSH workbench: saved sessions, the one being edited (id "" for a new one), the one
  /// connected (its id, its name), the one being connected to, and anything to say.
  ssh: List(Session),
  ssh_form: Option(Session),
  ssh_on: Option((String, String)),
  ssh_busy: String,
  ssh_note: String,
  /// The folder typed to go to on the connected machine.
  ssh_path: String,
  prompt: Option(Prompt),
  /// The explorer: a name being typed, and the file or folder last pointed at.
  naming: Option(Naming),
  pointed: String,
  blame: Option(Blame),
  /// Git's settings as it reads them here: (key, value, where it is set), and whether changes
  /// are made for this repository ("local") or for all of this person's ("global").
  /// repository): the commit shown, and every commit that changed the file, newest first.
  travel: Dict(String, String),
  histories: Dict(String, List((String, String, Int, String))),
  /// Every file there was at a commit, for browsing a session's whole tree.
  trees: Dict(String, List(String)),
  /// The change being looked at in place: which file, and a line the change covers.
  peek: Option((String, Int)),
  /// Font families that have been added to Runes, besides the one it ships with.
  fonts: List(String),
  /// Names given to terminals by hand, and the last command each one ran.
  terminal_names: Dict(Int, String),
  terminal_last: Dict(Int, String),
  /// The terminal being renamed, and the text so far.
  renaming: Option((Int, String)),
  terminal_filter: String,
  /// Which list the Extensions view shows: "installed", "market" or "builtin".
  ext_tab: String,
  pages: Dict(String, Page),
  /// Quick fixes extensions offer where the cursor is.
  actions: List((Int, String, String)),
  /// Where a language server has something to offer (a fix, a refactoring): the file, the
  /// line, the edit of the file it was true for, and whether a fix is among it.
  bulb: Option((String, Int, Int, Bool)),
  market_note: String,
  show_builtin: Bool,
  paint: Int,
  toast: String,
  toasts: Int,
  untitled: Int,
}

pub type Msg {
  Booted(found: List((String, String, Bool)), problems: String, native: Bool, root: String, version: String, platform: String)
  /// Which extensions are switched off, as the shell keeps it.
  DisabledRead(ids: List(String))
  ExtToggled(id: String, on: Bool)
  ExtToggleDone(problem: String)
  RunningAsked
  /// A merge conflict in a file is settled: "ours", "theirs" or "both".
  ConflictTaken(path: String, index: Int, which: String)
  /// An extension, as it runs, has said how a language is indented.
  LanguageRules(language: String, rules: String)
  RunningRead(found: List((String, String, String, String, Int, String, Int, List((String, String, String)))))
  RunningPicked(id: String)
  HostRestarted
  /// A file or folder of the explorer was clicked, perhaps with Ctrl or Shift held.
  NodeClicked(path: String, folder: Bool, ctrl: Bool, shift: Bool)
  TreeKey(chord: String)
  /// Files of the tree were dropped on a folder, or pasted there.
  TreeMoved(sources: List(String), into: String, copy: Bool)
  /// Files from outside Runes were dropped on a folder, or pasted there.
  TreeImported(paths: List(String), into: String)
  FilesPlaced(into: String, sources: List(String), made: List(String), moved: Bool, problem: String)
  FilesGone(paths: List(String), problem: String)
  UserFiles(settings: String, keys: String)
  UserFileRead(path: String, text: String)
  Key(key: String, ctrl: Bool, shift: Bool, alt: Bool, editor: Bool, chord: String)
  Typed(text: String)
  Pasted(text: String)
  Resized
  Zoomed(by: Int)
  Scrolled(group: Int)
  MouseDown(group: Int, x: Int, y: Int, shift: Bool, clicks: Int)
  /// Alt+click: one more cursor there.
  CursorAdded(group: Int, x: Int, y: Int)
  /// Ctrl and a click: go to where the thing under the pointer is defined.
  DefinitionAt(group: Int, x: Int, y: Int)
  /// The fold mark beside a line was clicked.
  FoldToggled(path: String, line: Int)
  /// How the file in front is to be indented from now on: "\t", some spaces, or "" to read it from the file again.
  IndentPicked(unit: String)
  MouseDragged(group: Int, x: Int, y: Int)
  HoverAsked(group: Int, x: Int, y: Int)
  Hovered(group: Int, at: Pos, text: String)
  PieEvent(kind: String, x: Int, y: Int)
  PiePicked(index: Int)
  /// A slice was picked with the pointer at this spot; a submenu opens there.
  PiePickedAt(index: Int, x: Int, y: Int)
  GrammarLoaded
  DirRead(path: String, entries: List((String, Bool)))
  Walked(files: List(String))
  DirToggled(path: String)
  /// Something asked of the explorer about a file or folder ("" for the one pointed at):
  /// "newFile", "newFolder", "rename", "delete", "copyPath", "copyRelative", "reveal",
  /// "refresh" or "collapse".
  ExplorerDid(action: String, path: String)
  NamingTyped(text: String)
  NamingDone(keep: Bool)
  NamingLeft
  FileMade(path: String, folder: Bool, problem: String)
  FileMoved(from: String, to: String, problem: String)
  FileGone(path: String, removed: Bool, problem: String)
  /// The disk changed under the explorer: folders whose contents did, files whose text did,
  /// and whether the repository itself moved.
  FilesChanged(dirs: List(String), files: List(String), git: Bool)
  Blamed(found: Blame)
  GitDiscarded(paths: List(String))
  GitDiscardDone(done: Bool, problem: String)
  FileOpened(path: String)
  FileRead(path: String, text: String, problem: String)
  Reloaded(path: String, text: String)
  TabPicked(group: Int, path: String)
  TabClosed(group: Int, path: String)
  TabDragged(path: String, from: Int)
  DropHover(group: Int, edge: Edge)
  Dropped(group: Int, edge: Edge)
  DragEnded
  SashGrabbed(path: String, row: Bool)
  SashMoved(path: String, ratio: Float)
  EdgeGrabbed(which: String)
  EdgeMoved(which: String, x: Int, y: Int, width: Int, height: Int)
  Saved(path: String, version: Int, problem: String)
  SavedAs(old: String, path: String)
  SidePicked(side: String)
  PanelPicked(panel: String)
  TerminalPicked(id: Int)
  TerminalClosed(id: Int)
  PaletteTyped(query: String)
  PaletteMoved(index: Int)
  OverlayClosed
  FindTyped(query: String)
  ReplaceTyped(text: String)
  FindToggled(option: String)
  FindStep(by: Int)
  Replaced(all: Bool)
  FindClosed
  SearchTyped(query: String)
  SearchReplaceTyped(text: String)
  SearchToggled(option: String)
  SearchRan
  SearchFound(hits: List((String, Int, Int, Int, String)), problem: String)
  SearchReplaced(files: Int, count: Int, problem: String)
  SearchReplaceAll
  Jumped(path: String, line: Int, col: Int)
  Ran(command: String)
  InstallClicked
  VsixDropped(name: String, bytes: Bytes)
  Installed(id: String, manifest: String, problem: String)
  Removed(id: String)
  ThemePicked(label: String)
  FolderPicked(path: String)
  CompletionPicked(index: Int)
  /// A language server's answer, with where it was asked: the line, the column and the text of
  /// the line up to there. `known` is false when the character typed meant nothing to it.
  Completed(
    path: String,
    line: Int,
    col: Int,
    before: String,
    known: Bool,
    incomplete: Bool,
    items: List((String, String, String, Bool, String, Int, Int, String, String, String, Int, List((Int, Int, Int, Int, String)))),
  )
  /// More about one item, asked for when it was rested on or taken. `apply` means it was
  /// taken, and the changes that come with it (an import) are to be made.
  CompletionResolved(path: String, id: Int, detail: String, text: String, edits: List((Int, Int, Int, Int, String)), apply: Bool)
  Diagnosed(path: String, items: List((Int, Int, Int, Int, Int, String, String)))
  Noted(level: String, text: String)
  Defined(path: String, line: Int, col: Int)
  Formatted(path: String, version: Int, edits: List((Int, Int, Int, Int, String)))
  GitRefresh
  GitStatus(repo: Bool, branch: String, ahead: Int, behind: Int, files: List((String, String, String)))
  GitLogged(commits: List((String, List(String), String, Int, List(String), String)))
  GitStaged(paths: List(String), staged: Bool)
  GitDone(problem: String)
  CommitPicked(hash: String)
  CommitShown(hash: String, text: String)
  CalendarMoved(by: Int)
  CalendarZoomed(zoom: String)
  CalendarSet(year: Int, month: Int, zoom: String)
  DaysRead(days: List((String, Int)))
  /// Show the graph as the history stood at the end of a day ("" for now).
  GraphUntil(day: String)
  DayPicked(day: String)
  SettingChanged(key: String, value: String)
  PieChanged(slices: List(settings.Slice))
  /// One field of one slice: "label" or "command".
  PieSet(path: List(Int), field: String, value: String)
  MarketTyped(query: String)
  MarketRan
  MarketFound(found: List((String, String, String, String, String, Int, String)), problem: String)
  IconLoaded(url: String, data: String)
  BaseRead(path: String, lines: List(String), known: Bool)
  RefsRead(names: List((String, String)))
  CommitFiles(hash: String, files: List((String, String)))
  /// Open the diff tab on two points of the history, and optionally one file.
  CompareOpened(from: String, to: String, file: String)
  CompareTyped(id: Int, left: Bool, text: String)
  CompareRan(id: Int)
  CompareListed(id: Int, base: String, files: List((String, String)), problem: String)
  CompareFilePicked(id: Int, path: String)
  CompareSide(id: Int, left: Bool, file: String, lines: List(String))
  CompareOption(id: Int, option: String)
  /// A drawing changed on its board: the new text of its file.
  CanvasEdited(path: String, text: String)
  /// Show a drawing as text, or the text as a drawing again.
  CanvasRaw(path: String)
  /// An element of a drawing points at a file of the project ("src/shop.bea" or "src/shop.bea:12").
  CanvasLink(link: String)
  /// Move a session that shows one commit to the commit before or after it.
  CompareStepped(id: Int, by: Int)
  SessionPicked(id: Int)
  SessionClosed(id: Int)
  CommitMarked(hash: String)
  TerminalMoved(id: Int, to_editor: Bool)
  TerminalRan(id: Int, command: String)
  TerminalRename(id: Int)
  TerminalRenameTyped(text: String)
  TerminalRenamed(keep: Bool)
  TerminalFilter(text: String)
  WindowFocused
  FontsLoaded(families: List(String), problem: String)
  FontAddClicked
  FontRemoved(family: String)
  ExtTab(name: String)
  ExtOpened(id: String)
  MarketOpened(namespace: String, name: String)
  ReadmeRead(key: String, text: String)
  PieAdded(path: List(Int))
  PieRemoved(path: List(Int))
  PieMoved(path: List(Int), by: Int)
  GroupFocused(group: Int)
  GroupMaximized(group: Int)
  /// A mark in the gutter was clicked: show what changed there, in place.
  SshListed(sessions: List((String, String, String, String, Int, String, String, Bool, Bool, String)))
  /// Start editing a saved session, or a new one for "".
  SshEdit(id: String)
  SshField(field: String, value: String)
  SshFormSaved
  SshFormClosed
  SshSaved(problem: String)
  SshRemoved(id: String)
  SshForgot(id: String)
  SshImportClicked
  SshImported(count: Int, problem: String)
  SshConnect(id: String)
  SshConnected(id: String, name: String, folder: String, problem: String)
  SshDisconnect
  /// The session is over: back to a folder of this machine.
  SshLeft(folder: String, note: String)
  SshPathTyped(text: String)
  SshPathOpened(folder: String, problem: String)
  SshPathGo
  PromptShown(id: Int, kind: String, title: String, detail: String, initial: String)
  PromptTyped(text: String)
  PromptAnswered(ok: Bool)
  /// Open a file as it was at a branch, tag or commit.
  TimeTravel(file: String, from: String)
  HistoryRead(file: String, commits: List((String, String, Int, String)), at: String)
  TravelRead(file: String, at: String, lines: List(String))
  /// Step the file in front to the commit before (1) or after (-1) the one shown.
  TimeStepped(file: String, by: Int)
  TreeRead(at: String, files: List(String))
  CompareBrowse(id: Int, everything: Bool)
  CompareFilter(id: Int, text: String)
  ChangePeeked(group: Int, line: Int)
  ChangePeekMoved(by: Int)
  ChangePeekClosed
  ChangeReverted
  ActionsFound(found: List((Int, String, String)))
  BulbFound(path: String, line: Int, version: Int, count: Int, fix: Bool)
  ActionPicked(id: Int)
  ExtDone(problem: String)
  ExtEdits(path: String, edits: List((Int, Int, Int, Int, String)))
  ExtCommand(command: String)
  MarketInstalled(namespace: String, name: String)
  BuiltinToggled
  ToastDone(id: Int)
}

