//// Key chords and the commands they run. The defaults follow VS Code.

import gleam/dict
import gleam/dynamic/decode
import gleam/json
import gleam/list
import gleam/result
import gleam/string

pub type Binding {
  key: String,
  command: String,
}

/// VS Code's defaults for the commands Runes has.
pub const defaults = [
  Binding("ctrl+p", "workbench.action.quickOpen"),
  Binding("ctrl+shift+p", "workbench.action.showCommands"),
  Binding("f1", "workbench.action.showCommands"),
  Binding("ctrl+s", "workbench.action.files.save"),
  Binding("ctrl+n", "workbench.action.files.newUntitledFile"),
  Binding("ctrl+o", "workbench.action.files.openFolder"),
  Binding("ctrl+w", "workbench.action.closeActiveEditor"),
  Binding("ctrl+b", "workbench.action.toggleSidebarVisibility"),
  Binding("ctrl+j", "workbench.action.togglePanel"),
  Binding("ctrl+`", "workbench.action.terminal.toggleTerminal"),
  Binding("ctrl+shift+`", "workbench.action.terminal.new"),
  Binding("ctrl+shift+e", "workbench.view.explorer"),
  Binding("ctrl+shift+f", "workbench.view.search"),
  Binding("ctrl+shift+x", "workbench.view.extensions"),
  Binding("ctrl+shift+g", "workbench.view.scm"),
  Binding("ctrl+shift+m", "workbench.actions.view.problems"),
  Binding("ctrl+alt+i", "workbench.action.chat.open"),
  Binding("ctrl+,", "workbench.action.openSettings"),
  Binding("ctrl+k", "workbench.action.selectTheme"),
  Binding("ctrl+\\", "workbench.action.splitEditor"),
  Binding("ctrl+alt+\\", "workbench.action.splitEditorDown"),
  Binding("ctrl+1", "workbench.action.focusFirstEditorGroup"),
  Binding("ctrl+2", "workbench.action.focusSecondEditorGroup"),
  Binding("ctrl+3", "workbench.action.focusThirdEditorGroup"),
  Binding("ctrl+pagedown", "workbench.action.nextEditor"),
  Binding("ctrl+pageup", "workbench.action.previousEditor"),
  Binding("ctrl+tab", "workbench.action.nextEditor"),
  Binding("ctrl+shift+i", "workbench.action.toggleDevTools"),
  Binding("ctrl+=", "workbench.action.zoomIn"),
  Binding("ctrl+-", "workbench.action.zoomOut"),
  Binding("ctrl+0", "workbench.action.zoomReset"),
  Binding("ctrl+f", "actions.find"),
  Binding("ctrl+h", "editor.action.startFindReplaceAction"),
  Binding("f3", "editor.action.nextMatchFindAction"),
  Binding("shift+f3", "editor.action.previousMatchFindAction"),
  Binding("ctrl+g", "workbench.action.gotoLine"),
  Binding("ctrl+/", "editor.action.commentLine"),
  Binding("ctrl+d", "editor.action.addSelectionToNextFindMatch"),
  Binding("ctrl+shift+l", "editor.action.selectHighlights"),
  Binding("ctrl+alt+arrowup", "editor.action.insertCursorAbove"),
  Binding("ctrl+alt+arrowdown", "editor.action.insertCursorBelow"),
