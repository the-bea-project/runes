{
  "name": "bea-vscode-syntax",
  "displayName": "Bea Syntax",
  "description": "Syntax colouring, brackets and snippets for Bea. The full extension, with the language server, is in the marketplace.",
  "version": "0.5.0",
  "publisher": "adimj11",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "bea",
        "aliases": [
          "Bea",
          "bea"
        ],
        "extensions": [
          ".bea"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bea",
        "scopeName": "source.bea",
        "path": "./syntaxes/bea.tmLanguage.json"
      },
      {
        "comment": "```bea code blocks in Markdown",
        "scopeName": "markdown.bea.codeblock",
        "path": "./syntaxes/bea.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bea": "bea"
        }
      }
    ],
    "snippets": [
      {
        "language": "bea",
        "path": "./snippets/bea.json"
      }
    ]
  }
}