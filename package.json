{
  "name": "runes",
  "version": "1.1.0",
  "description": "Runes: an elegant, minimal code editor, extended by VS Code extensions",
  "main": "shell/main.cjs",
  "scripts": {
    "build": "bea build && node scripts/build.mjs",
    "start": "electron .",
    "web": "node scripts/serve.mjs",
    "test": "node scripts/bea-tests.mjs && node --test shell/shell.test.cjs shell/ssh.test.cjs test/canvas.test.mjs && node e2e/exthost.test.mjs",
    "test:app": "node e2e/app.test.cjs",
    "package": "node scripts/release.mjs --dir",
    "release": "node scripts/release.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "fflate": "^0.8.3",
    "ssh2": "^1.17.0",
    "vscode-uri": "^3.2.0"
  },
  "productName": "Runes",
  "private": true,
  "author": {
    "name": "The Runes contributors"
  },
  "homepage": "https://github.com/the-bea-project/runes",
  "build": {
    "appId": "dev.runes.editor",
    "productName": "Runes",
    "copyright": "Apache-2.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "shell/**",
      "!shell/*.test.cjs",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "shell/helpers/**",
      "shell/ask.cjs"
    ],
    "artifactName": "Runes-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "fileAssociations": [],
    "linux": {
      "target": [
        "tar.gz",
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "executableName": "runes",
      "synopsis": "An elegant, minimal code editor",
      "description": "Runes is an elegant, minimal code editor. Carve your code. Languages, themes and language servers come from VS Code extensions.",
      "maintainer": "The Runes contributors",
      "extraFiles": [
        {
          "from": "scripts/install-linux.sh",
          "to": "install.sh"
        }
      ],
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ],
      "syncDesktopName": true,
      "files": [
        "!**/node_modules/@lydell/node-pty-win32-*/**",
        "!**/node_modules/@lydell/node-pty-darwin-*/**"
      ]
    },
    "deb": {
      "packageName": "runes"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "files": [
        "!**/node_modules/@lydell/node-pty-linux-*/**",
        "!**/node_modules/@lydell/node-pty-darwin-*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Runes",
      "uninstallDisplayName": "Runes",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "files": [
        "!**/node_modules/@lydell/node-pty-linux-*/**",
        "!**/node_modules/@lydell/node-pty-win32-*/**"
      ]
    },
    "npmRebuild": false
  },
  "desktopName": "runes.desktop"
}
